export DOTFILES="$HOME/.dotfiles"

dotfiles-push() {
  cd "$DOTFILES" && git add -A && git commit -m "${1:-.}" || true && git push
}

dotfiles-pull() {
  cd "$DOTFILES" && git pull
}
dotfiles-update() {
    dotfiles-pull
    dotfiles-install
}

dotfiles-stow() {
  (
    cd "$DOTFILES" || exit
    ./scripts/install-shrc.sh
    ./scripts/run-stow.sh
  )
}

dotfiles-install(){
  cd "$DOTFILES" && ./install.sh
}

alias claude-unsafe='claude --allow-dangerously-skip-permissions'

export CLICOLOR=1
export DROPBOX="$HOME/Dropbox" 	# NOTE: might be linked type
export PATH="$HOME/.local/bin/:$PATH"
export PATH="$HOME/.fzf/bin/:$PATH"
# export PATH="$HOME/.config/emacs:$PATH"


# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"


mkdir -p ~/.tmux-sockets
chmod 700 ~/.tmux-sockets
export TMUX_TMPDIR=$HOME/.tmux-sockets
